[Unit]
Description=Pattern Lens page and API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/PatternLens
EnvironmentFile=/home/ubuntu/PatternLens/pl.env
ExecStart=/home/ubuntu/PatternLens/.venv/bin/uvicorn serve:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
